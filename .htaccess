Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.sample\.php|.*\.(xlsx|sqlite3|db|sql|log|bak|env))$">
    Require all denied
  </FilesMatch>
  RedirectMatch 403 ^/(src|data|tests|scripts|tools|app)(/|$)
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.sample\.php|.*\.(xlsx|sqlite3|db|sql|log|bak|env))$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Long-cache static assets (cache-busted via ?v=filemtime in HTML)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|gif|ico|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
